<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/pad"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="‹"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProjectName"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="精剪" />

            <TextView
                android:id="@+id/tvTimelineMeta"
                style="@style/Text.Tiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 秒 · 0 条轨道 · 已保存" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExportTop"
            style="@style/Chip.On"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导出" />
    </LinearLayout>

    <!-- 预览 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="@dimen/pad"
        android:layout_marginEnd="@dimen/pad"
        android:background="@drawable/bg_card">

        <ImageView
            android:id="@+id/ivFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="当前镜头"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvFrameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="选择镜头预览"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- 轨道区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/pad"
        android:paddingEnd="@dimen/pad"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Tiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="画面轨" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideoTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@color/line" />

            <TextView
                android:id="@+id/rowNarration"
                style="@style/Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:text="🎙 AI 旁白轨" />

            <TextView
                android:id="@+id/rowMusic"
                style="@style/Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:text="♫ 音乐轨" />
        </LinearLayout>
    </ScrollView>

    <!-- AI 建议 -->
    <LinearLayout
        android:id="@+id/cardAdvice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pad"
        android:layout_marginEnd="@dimen/pad"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_brand"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAdvice"
            style="@style/Text.Tiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="AI 精剪建议" />
    </LinearLayout>

    <!-- 选中片段工具条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panel"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/panelTrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnInMinus"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="入点 -0.2s" />

            <TextView
                android:id="@+id/btnInPlus"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="入点 +0.2s" />

            <TextView
                android:id="@+id/btnOutMinus"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="出点 -0.2s" />

            <TextView
                android:id="@+id/btnOutPlus"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="出点 +0.2s" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMoveLeft"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="◀ 前移一位" />

            <TextView
                android:id="@+id/btnMoveRight"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="后移一位 ▶" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelected"
            style="@style/Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="未选中片段" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toolSplit"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="✂ 分割" />

            <TextView
                android:id="@+id/toolSpeed"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="⏩ 变速" />

            <TextView
                android:id="@+id/toolEffect"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="✦ 特效" />

            <TextView
                android:id="@+id/toolDelete"
                style="@style/Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🗑 删除" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
