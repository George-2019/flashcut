<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#323648" />
            <corners android:radius="@dimen/chip_radius" />
            <stroke android:width="1dp" android:color="@color/brand" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2340" />
            <corners android:radius="@dimen/chip_radius" />
            <stroke android:width="1dp" android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2230" />
            <corners android:radius="@dimen/chip_radius" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
