<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：按下时变暗，给出明确反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3A3D4D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#5B3FD6" android:endColor="#7B5CFF" android:angle="0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#7B5CFF" android:endColor="#9B7BFF" android:angle="0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
