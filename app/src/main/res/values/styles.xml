<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Title" parent="">
        <item name="android:textSize">@dimen/title</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/body</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Sub" parent="">
        <item name="android:textSize">@dimen/small</item>
        <item name="android:textColor">@color/sub</item>
    </style>
    <style name="Text.Tiny" parent="">
        <item name="android:textSize">@dimen/tiny</item>
        <item name="android:textColor">@color/sub</item>
    </style>
    <style name="Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">@dimen/small</item>
        <item name="android:textColor">@color/sub</item>
    </style>
    <style name="Chip.On" parent="Chip">
        <item name="android:background">@drawable/bg_chip_brand</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Btn.Primary" parent="">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Ghost" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="NavItem" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
